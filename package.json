{
  "name": "slate",
  "version": "0.6.2",
  "description": "A free, open-source media file renamer for TV shows and anime.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "package": "npm run build && electron-builder --publish never --config electron-builder.yml",
    "make": "npm run package",
    "test": "vitest run --config vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
